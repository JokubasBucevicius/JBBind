# JBBind — Apptainer definition.
#
# This is the primary runnable artifact on an HPC box: there is no docker daemon on the
# cluster this was built for, but Apptainer pulls Docker Hub layers directly, so this
# builds natively with no registry involved.
#
#   apptainer build --fakeroot jbbind.sif apptainer.def
#   apptainer run --bind /scratch/jbbind:/data --cleanenv jbbind.sif
#   apptainer exec --bind /scratch/jbbind:/data --cleanenv jbbind.sif \
#       jbbind batch targets.csv --out results/
#   apptainer run --nv --bind /scratch/jbbind:/data --cleanenv jbbind.sif   # GPU
#
# Each %post block mirrors the corresponding Dockerfile stage; keep them in step.
#
# BUILD PRIVILEGES: /etc/subuid on the target cluster has no entry for the invoking user,
# but unprivileged user namespaces are enabled and /usr/bin/fakeroot exists, so
# --fakeroot falls back to single-user mapping. If apt-get in %post still fails, either
# build with --sandbox and convert, or ask an admin for
#   usermod --add-subuids 100000-165535 --add-subgids 100000-165535 <user>

Bootstrap: docker
From: python:3.13-slim

# Single stage on purpose: a multi-stage def would need a registry or a second build,
# and purging the build tools at the end of %post recovers most of what a builder stage
# would have saved.
#
# Apptainer's %files directory semantics are version-dependent and bit us twice: with
# `tools /app/tools` the payload landed at /app/tools/tools, and with `tools /app` it
# landed as loose files directly in /app. Rather than guess, stage everything under
# /opt/stage and have %post put it in place, checking for both layouts. Deterministic,
# and it fails loudly instead of producing a half-populated /app.
%files
    requirements.txt /opt/stage/requirements.txt
    tools /opt/stage/tools
    models /opt/stage/models
    jbbind /opt/stage/jbbind
    tests /opt/stage/tests
    pytest.ini /opt/stage/pytest.ini

%post
    set -eux
    apt-get update
    apt-get install -y --no-install-recommends \
        bash coreutils gawk sed grep ca-certificates curl tini \
        build-essential cmake
    rm -rf /var/lib/apt/lists/*

    # --- voronota, from source (mirrors the Dockerfile's voronota stage)
    VORONOTA_VERSION=1.29.4781
    mkdir -p /opt/voronota-build
    cd /opt/voronota-build
    curl -fsSL -o voronota.tar.gz \
      "https://github.com/kliment-olechnovic/voronota/releases/download/v${VORONOTA_VERSION}/voronota_${VORONOTA_VERSION}.tar.gz"
    tar xf voronota.tar.gz
    cd "voronota_${VORONOTA_VERSION}/expansion_js"
    cmake .
    make -j"$(nproc)"
    install -m 0755 ./voronota-js /usr/local/bin/voronota-js

    # --- python deps (mirrors the Dockerfile's pip layer)
    pip install --no-cache-dir \
        --index-url "${TORCH_INDEX_URL:-https://download.pytorch.org/whl/cpu}" \
        --extra-index-url https://pypi.org/simple \
        -r /opt/stage/requirements.txt

    # --- ESM-2 650M, baked in (mirrors the Dockerfile's weights layer)
    export TORCH_HOME=/opt/torch
    mkdir -p "$TORCH_HOME/hub/checkpoints"
    curl -fsSL -o "$TORCH_HOME/hub/checkpoints/esm2_t33_650M_UR50D.pt" \
        https://dl.fbaipublicfiles.com/fair-esm/models/esm2_t33_650M_UR50D.pt
    curl -fsSL -o "$TORCH_HOME/hub/checkpoints/esm2_t33_650M_UR50D-contact-regression.pt" \
        https://dl.fbaipublicfiles.com/fair-esm/regression/esm2_t33_650M_UR50D-contact-regression.pt
    python -c "import esm; esm.pretrained.esm2_t33_650M_UR50D()" >/dev/null

    # Build tools are not needed at runtime and are ~400 MB of SIF.
    apt-get purge -y build-essential cmake
    apt-get autoremove -y
    rm -rf /opt/voronota-build /var/lib/apt/lists/*

%post
    set -eux

    # Move the staged payload into /app, tolerating either %files layout: the contents
    # may sit directly in /opt/stage/<name>, or nested one level deeper.
    rm -rf /app
    mkdir -p /app
    for d in tools models jbbind tests; do
        if [ -d "/opt/stage/$d/$d" ]; then
            mv "/opt/stage/$d/$d" "/app/$d"
        elif [ -d "/opt/stage/$d" ]; then
            mv "/opt/stage/$d" "/app/$d"
        else
            echo "ERROR: /opt/stage/$d was not staged. /opt/stage contains:" >&2
            find /opt/stage -maxdepth 2 >&2
            exit 1
        fi
    done
    cp /opt/stage/pytest.ini /app/pytest.ini

    # Build artefacts from the host must not travel into the image.
    find /app -name __pycache__ -type d -prune -exec rm -rf {} + || true
    find /app -name '*.pyc' -delete || true

    # Fail loudly with a listing rather than a bare chmod error further down.
    for required in /app/tools/describe-receptor-chain /app/jbbind/main.py \
                    /app/models/MANIFEST.json /app/tests/conftest.py; do
        if [ ! -f "$required" ]; then
            echo "ERROR: $required is missing. /app contains:" >&2
            find /app -maxdepth 2 >&2
            exit 1
        fi
    done
    test "$(python -c 'import json;print(len(json.load(open("/app/models/MANIFEST.json"))))')" = "20"
    chmod +x /app/tools/describe-receptor-chain
    rm -rf /opt/stage
    mkdir -p /data/cache

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/app
    # $HOME is auto-mounted by Apptainer, and a stale ~/.cache/torch would shadow the
    # baked weights. Pin TORCH_HOME explicitly and run with --cleanenv.
    export TORCH_HOME=/opt/torch
    export JBBIND_MODELS=/app/models
    export JBBIND_CACHE=${JBBIND_CACHE:-/data/cache}
    # The image is read-only. The voronota wrappers call `mktemp -d`, so TMPDIR must
    # point somewhere writable — bind-mount it if /tmp inside the container is not.
    export TMPDIR=${JBBIND_TMP:-/tmp}
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
    export MKL_NUM_THREADS=${MKL_NUM_THREADS:-4}

%runscript
    cd /app
    if [ "$#" -eq 0 ]; then
        exec python -m uvicorn jbbind.main:app --host 0.0.0.0 --port 8000 --workers 1
    fi
    exec python -m jbbind.cli "$@"

%apprun jbbind
    cd /app && exec python -m jbbind.cli "$@"

%test
    set -eux
    command -v voronota-js
    python -c "import torch, esm, gemmi, torch_geometric, fastapi; print('imports ok')"
    # /app is read-only in the built image, so pytest must not try to write its cache
    # there. Running from a writable cwd is not enough — disable the cache plugin.
    cd /tmp && python -m pytest /app/tests -q -x -p no:cacheprovider -p no:warnings \
        --rootdir=/app -o cache_dir=/tmp/.pytest_cache

%labels
    Name        JBBind
    Description Per-residue protein/nucleic binding-site prediction
    Voronota    1.29.4781
    ESM         esm2_t33_650M_UR50D

%help
    JBBind predicts, for every surface residue of a protein chain, whether it binds a
    protein or a nucleic acid.

      apptainer run  --bind /scratch/jbbind:/data --cleanenv jbbind.sif
          start the web app on port 8000

      apptainer exec --bind /scratch/jbbind:/data --cleanenv jbbind.sif \
          jbbind predict 1ycr --chain A
          predict one chain

      apptainer exec --bind /scratch/jbbind:/data --cleanenv jbbind.sif \
          jbbind batch targets.csv --out results/
          predict many chains, resumably

    Add --nv to use a GPU (only worth it for batch runs; ESM-2 is the bottleneck).
